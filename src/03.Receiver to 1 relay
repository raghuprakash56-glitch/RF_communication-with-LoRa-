#include <LoRa_E220.h>

#define LED_PIN 2

#define LORA_RX 16
#define LORA_TX 17

#define PIN_M0 18
#define PIN_M1 5
#define PIN_AUX 4

HardwareSerial LoRaSerial(2);
LoRa_E220 e220(&LoRaSerial, PIN_M0, PIN_M1, PIN_AUX);

void setup() {

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, HIGH);

  Serial.begin(115200);
  delay(2000);

  Serial.println("================================");
  Serial.println("E220 RECEIVER STARTED");
  Serial.println("================================");

  LoRaSerial.begin(9600, SERIAL_8N1, LORA_RX, LORA_TX);

  e220.begin();

  e220.setMode(MODE_0_NORMAL);

  delay(500);

  Serial.println("Receiver Ready!");
}

void loop() {

  int availableBytes = e220.available();

  if (availableBytes > 0) {

    Serial.print("Available Bytes: ");
    Serial.println(availableBytes);

    ResponseContainer rc = e220.receiveMessage();

    Serial.print("Status: ");
    Serial.println(rc.status.getResponseDescription());

    if (rc.status.code == E220_SUCCESS) {

      Serial.print("Received: ");
      Serial.println(rc.data);

      digitalWrite(LED_PIN, LOW);
      delay(100);
      digitalWrite(LED_PIN, HIGH);
    }
  }

  delay(100);
}
